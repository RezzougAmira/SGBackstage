# Configuration de la base de données
DATABASE_URL=postgresql://postgres:password@localhost:5432/sgb_techtrace

# Configuration JWT
JWT_SECRET=votre_cle_secrete_tres_longue_et_complexe
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Configuration du serveur
API_HOST=0.0.0.0
API_PORT=3001

# CORS — origines du frontend autorisées, séparées par des virgules.
# Exemple en production : ALLOWED_ORIGINS=https://sgb-techtrace.vercel.app
# Les localhost sont toujours acceptés en plus.
ALLOWED_ORIGINS=

# Supabase Storage (upload des images de masque)
# ATTENTION : SUPABASE_KEY doit être la clé "service_role" (Dashboard > Settings > API > service_role),
# et NON la clé publishable "sb_publishable_..." ni la clé "anon".
# Ces dernières sont soumises aux RLS policies et l'upload échoue avec un 403
# "new row violates row-level security policy".
# Le service_role contourne les RLS : ne l'expose jamais au frontend.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=cle_service_role_ici
SUPABASE_BUCKET=process-diagrammes
